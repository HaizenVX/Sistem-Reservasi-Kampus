# Isi di dashboard hosting; jangan simpan password di repository.
PUBLIC_ORIGIN=https://NAMA-SERVICE.onrender.com
BIND_ADDRESS=0.0.0.0
PORT=10000
DB_URL=jdbc:mysql://HOST:3306/DATABASE?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Jakarta&connectTimeout=15000&socketTimeout=30000
DB_USER=USER_DATABASE
DB_PASSWORD=ISI_DI_SECRET_HOSTING
# Container hanya menjalankan server. Migrasi dilakukan sekali, bukan tiap restart.
